<?xml version="1.0" encoding="utf-8"?> 
<odoo> 
    
    <!-- List Estudiants -->
    <record model="ir.ui.view" id="school_student_list">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="display_name" string="Full Name"></field>
                <field name="age"></field>
                <field name="phone"></field>
                <field name="email"></field>
                <field name="birthdate" optional="hide"></field>
            </list>
        </field>
    </record>

    <!-- Form Estudiants -->
    <record model="ir.ui.view" id="school_student_form">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <group col="4">
    
                            <group string="Personal Information" colspan="4" col="4">
                                <field name="first_name" colspan="4"></field>
                                <field name="last_name" colspan="4"></field>

                                <!-- Si no posem res, és col="2"-->
                                <field name="birthdate"></field>
                                <field name="country_id" string="Birthcountry"></field>

                                <field name="gender"></field>
                                <field name="tin" string="Birthcountry" required="age &gt; 14"></field>
                                
                                <field name="phone"></field>

                                <field name="email" colspan="4"></field>
                            </group>

                            <group string="Student Address" colspan="4" col="4">
                                <field name="street1" string="Address" colspan="4"></field>
                                <field name="street2" nolabel="1" colspan="4"></field>

                                <field name="zip"></field>
                                <field name="city"></field>

                                <field name="state_id"></field>
                                <field name="state_country"></field>
                            </group>
                            
                        </group>

                        <group col="4">
                            <group string="Information of tutors" colspan="4">
                                <field name="parent_info" nolabel="1"></field>
                            </group>

                            <group string="Information of client who pays..." colspan="4" col="4">
                                <field name="ci_name"></field>
                                <field name="ci_phone"></field>

                                <field name="ci_address" colspan="4"></field>

                                <field name="ci_zip"></field>
                                <field name="ci_city"></field>

                                <field name="ci_state_id"></field>
                                <field name="ci_country_id"></field>
                            </group>
                        </group>
                    </group>

                    <group string="Enrollments" colspan="8">
                        <field name="enrollment_ids" nolabel="1" widget="one2many_list" options="{'no_create': True, 'no_edit': True}">
                            <list>
                                <field name="edition_id"></field>
                                <field name="qualification"></field>
                            </list>
                        </field>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció d'Estudiants -->
    <record model="ir.actions.act_window" id="school_student_action">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu d'Estudiants -->
    <menuitem name="Students" id="menu_students" parent="school_pau.menu_root" sequence="80" action="school_student_action"/>


    <!-- List Matricules -->
    <record model="ir.ui.view" id="school_enrollment_list">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments">
                <field name="edition_id"></field>
                <field name="date_start"></field>
                <field name="date_end"></field>
                <field name="student_id"></field>
            </list>
        </field>
    </record>

    <!-- Form Matricules -->

    <!-- Acció de Matrícules -->
    <record model="ir.actions.act_window" id="school_enrollment_action">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu de Matrícules -->
    <menuitem name="Enrollments" id="menu_enrollment" parent="school_pau.menu_root" sequence="85" action="school_enrollment_action"/>

</odoo> 
